      "dependencies": { "@acme/util": "*", "react": "^18.2.0" }
    },
    "packages/web/node_modules/react": { "version": "18.2.0" },
    "packages/util": {
      "name": "@acme/util",
      "version": "0.1.0",
      "dependencies": { "lodash": "^4.17.0" }
    },
    "node_modules/lodash": { "version": "4.17.20" }
  }
}
